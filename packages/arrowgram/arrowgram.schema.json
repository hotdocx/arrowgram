{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "nodes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "^__arrowgram_internal__"
            }
          },
          "label": {
            "type": "string",
            "maxLength": 16384
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[uU][rR][lL]\\s*\\("
            }
          },
          "left": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "top": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "name",
          "left",
          "top"
        ],
        "additionalProperties": false
      }
    },
    "arrows": {
      "default": [],
      "maxItems": 4000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "^__arrowgram_internal__"
            }
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "^__arrowgram_internal__"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "^__arrowgram_internal__"
            }
          },
          "label": {
            "type": "string",
            "maxLength": 16384
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[uU][rR][lL]\\s*\\("
            }
          },
          "label_color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "pattern": "[uU][rR][lL]\\s*\\("
            }
          },
          "curve": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "shift": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "radius": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "angle": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "label_alignment": {
            "type": "string",
            "enum": [
              "over",
              "left",
              "right"
            ]
          },
          "shorten": {
            "type": "object",
            "properties": {
              "source": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "target": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "additionalProperties": false
          },
          "style": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "arrow",
                  "adjunction",
                  "corner",
                  "corner_inverse"
                ]
              },
              "head": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "none",
                      "epi",
                      "hook",
                      "maps_to",
                      "harpoon"
                    ]
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "tail": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "none",
                      "mono",
                      "hook",
                      "maps_to"
                    ]
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "body": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "solid",
                      "dashed",
                      "dotted",
                      "squiggly",
                      "wavy",
                      "barred",
                      "double_barred",
                      "bullet_solid",
                      "bullet_hollow",
                      "none"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/hotdocx/arrowgram/main/packages/arrowgram/arrowgram.schema.json",
  "title": "Arrowgram Format v1",
  "description": "Structural schema for Arrowgram format v1 commutative diagrams.",
  "$comment": "Graph identity, endpoint, cycle, dependency-depth, and loop semantics require @hotdocx/arrowgram parseDiagramSpec/validateDiagramSpec after structural JSON Schema validation.",
  "x-arrowgram-format-version": 1,
  "x-arrowgram-semantic-validator": "@hotdocx/arrowgram.parseDiagramSpec"
}
