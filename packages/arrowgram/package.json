{
    "name": "@hotdocx/arrowgram",
    "version": "2.0.0-rc.0",
    "description": "A React library for creating commutative diagrams with a declarative JSON syntax.",
    "author": "Antigravity",
    "license": "MIT",
    "homepage": "https://github.com/hotdocx/arrowgram/tree/main/packages/arrowgram",
    "bugs": {
        "url": "https://github.com/hotdocx/arrowgram/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hotdocx/arrowgram.git",
        "directory": "packages/arrowgram"
    },
    "keywords": [
        "commutative-diagrams",
        "category-theory",
        "react",
        "svg",
        "quiver"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js",
            "require": "./dist/schema.cjs"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js",
            "require": "./dist/core.cjs"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.js",
            "require": "./dist/react.cjs"
        },
        "./arrowgram.schema.json": "./arrowgram.schema.json"
    },
    "files": [
        "dist",
        "arrowgram.schema.json",
        "CHANGELOG.md",
        "THIRD_PARTY_NOTICES.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build:lib": "vite build",
        "build": "npm run build:lib && npm run schema:generate",
        "schema:generate": "node ./scripts/generate_schema.mjs",
        "schema:check": "npm run build:lib && node ./scripts/check_schema.mjs",
        "typecheck": "tsc -p tsconfig.check.json --pretty false",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts --max-warnings=0",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:property": "vitest run test/property",
        "test:render": "vitest run test/label-contract.test.tsx test/geometry.characterization.test.ts",
        "benchmark:run": "node ./scripts/benchmark.mjs",
        "benchmark": "npm run build && node ./scripts/benchmark.mjs",
        "verify:package:built": "node ./scripts/verify_package.mjs",
        "verify:package": "npm run build && node ./scripts/verify_package.mjs",
        "check:fast": "npm run typecheck && npm run lint && npm run test:unit",
        "check": "npm run check:fast && npm run test:coverage && npm run test:property && npm run schema:check && npm run benchmark:run && npm run verify:package:built",
        "prepublishOnly": "npm run check"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=20.19"
    },
    "peerDependencies": {
        "katex": "^0.16.47",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "katex": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "dependencies": {
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/katex": "^0.16.8",
        "@types/node": "^25.0.6",
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^5.0.0",
        "ajv": "^8.20.0",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "esbuild": "0.25.5",
        "fast-check": "^4.9.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0",
        "vitest": "^5.0.0"
    }
}
